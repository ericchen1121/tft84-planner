{
  "name": "eightfold-tft-planner",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test:overlay": "node tools/test-overlay.mjs",
    "smoke:overlay": "electron . --smoke-test",
    "package:win": "npm run build && powershell -NoProfile -File tools/package-windows.ps1",
    "build": "node tools/build.mjs",
    "test": "node tools/test.mjs && node tools/test-numeric-values.mjs && node tools/test-recommendations.mjs && node tools/test-team-code.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "dev": "node tools/serve.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "electron": "45.4.1"
  }
}
